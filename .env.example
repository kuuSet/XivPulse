# Optional model-provider overrides. Never commit a populated .env file.
XIVPULSE_BASE_URL=https://api.openai.com/v1
XIVPULSE_MODEL=gpt-4o-mini
XIVPULSE_API_KEY=
XIVPULSE_DATABASE_URL=
XIVPULSE_HOST=127.0.0.1
XIVPULSE_PORT=8765
# Host port used by docker compose. Change this when 8765 is occupied.
XIVPULSE_PUBLISHED_PORT=8765
# Optional request timeout in seconds (5-600).
XIVPULSE_REQUEST_TIMEOUT=180
# Disabled by default so a public checkout never reads ~/.codex credentials implicitly.
XIVPULSE_IMPORT_CODEX_CONFIG=false
