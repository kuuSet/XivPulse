# Optional model-provider overrides. Never commit a populated .env file.
XIVPULSE_MODEL_NAME=gpt-4o-mini
XIVPULSE_API_BASE_URL=https://api.openai.com/v1
XIVPULSE_API_KEY=
# Optional request timeout in seconds (5-600).
XIVPULSE_API_TIMEOUT_SECONDS=180

# Host Codex login directory used by docker-compose.codex.yml only.
# Example on Windows: C:/Users/you/.codex
XIVPULSE_CODEX_HOME=

XIVPULSE_DATA_DIR=
XIVPULSE_HOST=127.0.0.1
XIVPULSE_PORT=8765
# Host port used by docker compose. Change this when 8765 is occupied.
XIVPULSE_PUBLISHED_PORT=8765
