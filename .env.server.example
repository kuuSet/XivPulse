# Copy this file to .env.server. Never commit .env.server.
XIVPULSE_PUBLIC_HOST=203.0.113.10
XIVPULSE_PUBLIC_URL=https://203.0.113.10
XIVPULSE_SERVER_ALLOWED_HOSTS=["203.0.113.10","127.0.0.1","localhost","xivpulse"]

XIVPULSE_AUTH_USERNAME=admin
# Keep the Argon2 value single-quoted so Compose preserves its dollar signs.
XIVPULSE_AUTH_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$replace_me'
XIVPULSE_AUTH_SESSION_SECRET=replace_with_at_least_32_random_bytes

XIVPULSE_MODEL_NAME=gpt-4o-mini
XIVPULSE_API_BASE_URL=https://api.openai.com/v1
XIVPULSE_API_KEY=

XIVPULSE_EMAIL_ENABLED=false
XIVPULSE_EMAIL_RECIPIENTS=["you@example.com"]

XIVPULSE_SMTP_HOST=smtp.example.com
XIVPULSE_SMTP_PORT=587
XIVPULSE_SMTP_SECURITY=starttls
XIVPULSE_SMTP_USERNAME=
XIVPULSE_SMTP_PASSWORD=
XIVPULSE_SMTP_SENDER=xivpulse@example.com
